# Copiar para .env.test apenas apos autorizacao para usar o banco de testes.
# Nao usar DATABASE_URL nem copiar automaticamente o .env de desenvolvimento.
TEST_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/siscota_test
# Descomentar SOMENTE apos autorizar insercoes transacionais das fixtures:
# TEST_DB_WRITES=authorized
# Para o script de preparacao (nao utilizado pelos testes):
# TEST_SCHEMA_SOURCE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/siscota
# Se o usuario acima nao tiver CREATEDB, informar um administrador (nao enviar a senha no chat):
# TEST_ADMIN_DATABASE_URL=postgresql://ADMIN:SENHA@127.0.0.1:5432/postgres
PG_BIN=H:/Postgress/bin
TEST_API_PORT=8081
