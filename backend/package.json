{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-isolation=none --test-skip-pattern=\"^PostgreSQL real:\" test/*.test.js test/integration/*.test.js",
    "test:integration": "node --test --test-isolation=none --test-skip-pattern=\"^PostgreSQL real:\" test/*.test.js test/integration/*.test.js",
    "test:unit": "node --test --test-isolation=none test/*.test.js",
    "test:http:mock": "node --test --test-isolation=none --test-name-pattern=\"Protecao|HTTP e servico\" test/integration/*.test.js",
    "test:db:prepare": "node scripts/prepare-test-database.js --authorize-create",
    "demo:plan": "node scripts/seed-demo.js",
    "demo:seed": "node scripts/seed-demo.js --apply",
    "demo:audit": "node scripts/audit-demo.js",
    "start:test": "node scripts/start-test-api.js",
    "diagnose:dev": "node scripts/diagnose-development.js",
    "seed:dev": "node scripts/seed-development.js --apply-authorized",
    "test:dev:real": "node --test test/development/*.test.js",
    "setup:periodos": "node scripts/setup-workflow-periods.js",
    "setup:conta": "node scripts/setup-workflow-account.js",
    "test:auth": "node --test --test-isolation=none test/betterAuth.test.js",
    "setup:local": "node scripts/setup-local-database.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "1.7.19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
