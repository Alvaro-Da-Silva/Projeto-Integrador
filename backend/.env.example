# Use uma URL de conexão OU as variáveis PG* abaixo. Nunca versione credenciais reais.
# DATABASE_URL=postgresql://usuario:senha@host:5432/siscota

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=siscota
PGUSER=siscota_codex
# PGPASSWORD=defina-no-ambiente-local
# PGSSLMODE=require

PORT=8080

# Better Auth 1.7.19. Gerar segredo privado aleatorio; nunca copiar exemplos.
BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_SECRET=fornecer-privadamente-com-pelo-menos-32-caracteres
SISCOTA_TRUSTED_ORIGINS=http://localhost:3000
# Em producao: NODE_ENV=production e todas as origens em HTTPS.
